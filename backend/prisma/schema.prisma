generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String          @id @default(cuid())
  name           String
  email          String          @unique
  passwordHash   String          @map("password_hash")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  favoriteCities FavoriteCity[]
  searchHistory  SearchHistory[]

  @@map("users")
}

model SearchHistory {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  query      String
  cityName   String   @map("city_name")
  country    String?
  latitude   Float?
  longitude  Float?
  searchedAt DateTime @default(now()) @map("searched_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, searchedAt(sort: Desc)])
  @@map("search_history")
}

model FavoriteCity {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  cityName  String   @map("city_name")
  country   String?
  latitude  Float
  longitude Float
  timezone  String?
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, cityName])
  @@index([userId, createdAt(sort: Desc)])
  @@map("favorite_cities")
}

model CachedWeatherLog {
  id           String   @id @default(cuid())
  cacheKey     String   @unique @map("cache_key")
  cityName     String   @map("city_name")
  source       String   @default("openweathermap")
  payload      Json
  cacheHits    Int      @default(0) @map("cache_hits")
  lastStatus   String   @default("MISS") @map("last_status")
  expiresAt    DateTime @map("expires_at")
  lastFetchedAt DateTime @default(now()) @map("last_fetched_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([cityName])
  @@map("cached_weather_logs")
}
